rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User designs — owner access only
    match /users/{userId}/designs/{designId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /versions/{versionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /layers/{layerId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // User preferences — owner access only
    match /users/{userId}/preferences/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Booking requests — written server-side only (Admin SDK via
    // /api/v1/book). A signed-in user may read only their own requests
    // (docs carry the owner uid). No client writes, ever.
    match /booking_requests/{bookingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Artist availability — one doc per artist, maintained server-side.
    // Missing doc means "unknown" (UI: "availability on request").
    // Readable by signed-in users; no client writes.
    match /artist_availability/{artistId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Shared design links — written server-side only (Admin SDK via
    // /api/v1/designs/share, which records the owner uid on the doc).
    // Opening a share link is the product feature, so a single-doc `get`
    // is public; `list` stays denied so the collection can never be
    // enumerated by anyone holding the client key. Reads today go through
    // the Admin SDK (which bypasses rules) — this entry is the standing
    // contract for any future direct client read.
    match /shared_designs/{shareId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

