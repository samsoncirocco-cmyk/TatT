# TatTester Environment Configuration

# ==========================================
# CORE API CONFIGURATION
# ==========================================

# Demo mode (uses mock images instead of real API calls)
VITE_DEMO_MODE=false

# Browser-to-API requests use Firebase ID tokens. Do not add a shared
# NEXT_PUBLIC_* authentication secret; public variables ship to browsers.

# ==========================================
# FIREBASE AUTHENTICATION
# ==========================================

# Firebase client-side config (safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase server-side config (keep secret)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# GCP SECRET MANAGER
# ==========================================

GCP_PROJECT_ID=

# Cloud Tasks OIDC (only needed when asynchronous generation is enabled)
# Keep CLOUD_TASKS_ENABLED unset/false until a real Cloud Tasks request has
# passed OIDC verification against the live GCP project AND a spoofed request
# has been confirmed to fail (see docs/SECURITY_MODEL.md).
CLOUD_TASKS_ENABLED=false
CLOUD_RUN_URL=
TASK_SERVICE_ACCOUNT=
CLOUD_TASKS_AUDIENCE=

# Allowed CORS origins (comma-separated list, read by src/proxy.ts)
# Production: Add your frontend URL
# Example: https://tatt-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# LLM COUNCIL INTEGRATION
# ==========================================

# LLM Council API endpoint
VITE_COUNCIL_API_URL=http://localhost:8001/api

# Council demo mode (uses mock prompts without council backend)
# Set to true for testing UI without council backend running
# Set to false to use real council API
VITE_COUNCIL_DEMO_MODE=true

# Enable council-enhanced design generator
# Set to true to use DesignGeneratorWithCouncil
# Set to false to use original DesignGenerator
VITE_USE_COUNCIL=true

# ==========================================
# OPENROUTER INTEGRATION (Recommended)
# ==========================================

# Use OpenRouter for real LLM council (recommended over demo mode)
# Set to true to use OpenRouter API with real models
# Set to false to use demo mode or custom council backend
VITE_USE_OPENROUTER=false

# OpenRouter API Key
# Get your key from: https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter uses multiple models for "council members":
# - Claude 3.5 Sonnet (Creative Director)
# - GPT-4 Turbo (Technical Expert)
# - Gemini Pro 1.5 (Style Specialist)
# Estimated cost: $0.01-0.03 per enhancement

# ==========================================
# IMAGE GENERATION (Replicate/Vertex AI)
# ==========================================

# Replicate API Token (server-side only, used by the Next.js API routes)
# Get your token from: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_your_token_here

# Vertex AI (optional, for Imagen 3 model)
# VITE_VERTEX_AI_PROJECT_ID=your_project_id_here

# ==========================================
# BUDGET CONTROLS
# ==========================================

# Maximum daily spend (USD)
VITE_MAX_DAILY_SPEND=10.00

# Total budget (USD)
VITE_TOTAL_BUDGET=500.00

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable experimental features
VITE_ENABLE_INPAINTING=true
VITE_ENABLE_STENCIL_EXPORT=true
VITE_ENABLE_AR_PREVIEW=false

# Kill switch for displaying scraped portfolio images (TAT-31).
# Server-side only (deliberately NOT NEXT_PUBLIC_). Unset or any value other
# than "false" = current behavior (images shown). Set to "false" to stop
# displaying portfolio images for UNCLAIMED artists everywhere (roster cards,
# artist profiles, match results); claimed artists' images always show.
# Flipping this is a counsel/human decision. See src/lib/portfolio-display.ts.
SHOW_UNCLAIMED_PORTFOLIOS=true

# Instagram embed tier for unclaimed artists (TAT-40).
# Server-side only (deliberately NOT NEXT_PUBLIC_). Default off: only the
# literal "true" enables. When on, an UNCLAIMED artist's profile page (and
# only the profile page — card grids never mount iframes) renders official
# Instagram embeds from the permalinks on the :Artist node instead of hosted
# scraped copies; the media stays served by Meta, nothing is cached on TatT.
# Claimed artists always show their licensed hosted images instead.
# See src/lib/portfolio-display.ts and src/components/punk/InstagramEmbed.tsx.
ENABLE_IG_EMBEDS=false

# ==========================================
# NEO4J DATABASE (Phase 1)
# ==========================================

# Neo4j connection URI (default: bolt://localhost:7687)
NEO4J_URI=bolt://localhost:7687

# Neo4j authentication
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ==========================================
# SUPABASE (Database + Vector Search)
# ==========================================

# Supabase project URL
SUPABASE_URL=https://yfcmysjmoehcyszvkxsr.supabase.co

# Supabase anon/public key (safe to commit, used client-side)
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service role key (KEEP SECRET! Server-side only)
# Required for: vector embeddings, admin operations
# Get from: https://supabase.com/dashboard/project/yfcmysjmoehcyszvkxsr/settings/api
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Vector Search Configuration:
# - Uses pgvector extension (already enabled in Supabase)
# - Stores 4096-dimensional CLIP embeddings in portfolio_embeddings table
# - Enables semantic artist matching via cosine similarity
# - No additional API keys needed - reuses Supabase credentials above

# ==========================================
# UPSTASH REDIS (Rate Limiting)
# ==========================================

# Upstash Redis REST credentials for distributed rate limiting
# Get from: https://console.upstash.com/ (free tier: 10K requests/day)
# Without these, rate limiting falls back to in-memory (fine for local dev)
# UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ==========================================
# ANALYTICS (Optional)
# ==========================================

# VITE_ANALYTICS_ID=your_analytics_id_here
# VITE_SENTRY_DSN=your_sentry_dsn_here

# ==========================================
# STRIPE — Payments, Connect, Billing, Tax, Invoicing, Radar
# ==========================================
# Server-side secret key (test: sk_test_...). Placeholder → demo mode (no real charges).
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
# Publishable key — safe to expose to the browser (Stripe.js / embedded components).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
# Webhook signing secret for the main endpoint (whsec_...). Placeholder → webhook fails closed (503).
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
# Optional: separate signing secret if Connect events use their own webhook endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Non-prod ONLY escape hatch to accept unverified webhooks (never set in production).
STRIPE_WEBHOOK_ALLOW_PLACEHOLDER=false
# Platform take-rate on marketplace transactions, in basis points (1000 = 10%).
PLATFORM_FEE_BPS=1000
# Recurring Price id for the artist SaaS subscription (price_...). Create in the Stripe dashboard.
STRIPE_PRICE_ARTIST_SUB=
# Currency for charges/invoices (default usd).
STRIPE_CURRENCY=usd
# Days a deposit for an unclaimed artist is held before it's auto-refunded (default 7).
DEPOSIT_HOLD_DAYS=7
# Bearer secret the Vercel cron uses to authenticate the expire-deposits endpoint.
CRON_SECRET=
# Public app URL used to build Stripe success/cancel/return URLs.
NEXT_PUBLIC_APP_URL=https://tatttester.com
