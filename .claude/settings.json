{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dirty-tree-check.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking for uncommitted work..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "worktree"
  }
}
